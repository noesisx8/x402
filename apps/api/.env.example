# Deploy on Railway or portalv2 only — copy to host secrets, never commit .env
PORT=8080
# Railway listens on 0.0.0.0. portalv2 sets HOST=127.0.0.1 and exposes it with Tailscale Serve.
HOST=0.0.0.0
NODE_ENV=production
X402_ENABLED=true
PUBLIC_BASE_URL=https://your-service.up.railway.app
X402_NETWORK=base
X402_PAY_TO_ADDRESS=0x0000000000000000000000000000000000000000
X402_FACILITATOR_URL=https://x402.org/facilitator
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=