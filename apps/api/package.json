{
  "name": "@x402-project/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p ../../packages/request-guard/tsconfig.json --typeRoots ./node_modules/@types && tsc -p tsconfig.json",
    "check": "npm run build",
    "test:security": "npm run build && node --test scripts/openvuln.test.mjs",
    "start:deploy": "node dist/index.js",
    "dev:deploy-host-only": "node --watch dist/index.js"
  },
  "dependencies": {
    "@x402/core": "^2.17.0",
    "@x402/evm": "^2.17.0",
    "@x402-project/request-guard": "file:../../packages/request-guard",
    "@x402/express": "^2.17.0",
    "express": "^4.22.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "fast-uri": "^3.1.9",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.1"
  }
}